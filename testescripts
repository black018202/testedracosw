local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- Configurações de tempo (em segundos)
local INTERVALO_KILL = 10
local QUANTIDADE_KILLS = 3
local TEMPO_EXTRA_ATE_FREEZE = 30 -- Tempo extra após os kills antes de congelar
local DURACAO_FREEZE = 60 -- 1 minuto = 60 segundos
local MENSAGEM_KICK = "HAHAHA HACKING ROBLOX TUBERS93 EXPLOITS DECTED"

local function setCharacterFrozen(character, frozen)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")

	if humanoid then
		if frozen then
			humanoid.WalkSpeed = 0
			humanoid.JumpPower = 0
			humanoid.JumpHeight = 0
		else
			humanoid.WalkSpeed = 16
			humanoid.JumpPower = 50
			humanoid.JumpHeight = 7.2
		end
	end

	if rootPart then
		rootPart.Anchored = frozen
	end
end

-- 1. Loop de reset/kill (3 vezes, a cada 10 segundos)
for i = 1, QUANTIDADE_KILLS do
	task.wait(INTERVALO_KILL)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.Health = 0
	end
end

-- 2. Espera antes de ativar o freeze
task.wait(TEMPO_EXTRA_ATE_FREEZE)

local character = player.Character or player.CharacterAdded:Wait()
setCharacterFrozen(character, true)

local freezeAtivo = true
local respawnConnection = player.CharacterAdded:Connect(function(newChar)
	if freezeAtivo then
		newChar:WaitForChild("HumanoidRootPart", 5)
		setCharacterFrozen(newChar, true)
	end
end)

-- 3. Aguarda 1 minuto (60s) congelado, libera e aplica o kick imediatamente
task.wait(DURACAO_FREEZE)
freezeAtivo = false
if respawnConnection then
	respawnConnection:Disconnect()
end

local currentChar = player.Character
if currentChar then
	setCharacterFrozen(currentChar, false)
end

-- 4. Kicka o jogador
player:Kick(MENSAGEM_KICK)
