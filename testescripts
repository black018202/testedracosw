-- ==========================================
-- 3. EXECUTOR DAS FUNÇÕES E LEITURA DE CHAT DO CLIENTE
-- ==========================================
remoteEvent.OnClientEvent:Connect(function(tipoMsg, senderPlayer, dados)
    if tipoMsg == "Acao" then
        local char = LocalPlayer.Character
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        
        -- Se dados for tabela, é um comando complexo (Freeze/Inverter)
        if type(dados) == "table" then
            if dados.tipo == "Freeze" and humanoid then
                if dados.estado == true then
                    humanoid.WalkSpeed = 0
                    humanoid.JumpPower = 0
                else
                    humanoid.WalkSpeed = 16
                    humanoid.JumpPower = 50
                end
            elseif dados.tipo == "InverterControles" and humanoid then
                if dados.estado == true then
                    humanoid.WalkSpeed = -16
                else
                    humanoid.WalkSpeed = 16
                end
            end
        elseif dados == "Kill" and humanoid then
            -- Se for string simples "Kill"
            humanoid.Health = 0
        end

    elseif tipoMsg == "Chat" then
        -- Adiciona a mensagem recebida no chat interno de quem estiver logado (mesmo se o painel estiver fechado)
        adicionarMensagemChat(senderPlayer, dados)
        
        -- (Opcional) Aqui o Meno_rlk132 ou qualquer conta pode ler a mensagem e interpretar comandos via chat interno automaticamente se desejar
        print("[Chat Admin] " .. senderPlayer .. ": " .. dados)
    end
end)

-- ==========================================
-- 4. ATALHO DO TECLADO (Alt + W)
-- ==========================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.KeyCode == Enum.KeyCode.W then
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt) then
            painelAberto = not painelAberto
            
            if painelAberto then
                criarInterfaceMenu()
                screenGui.Enabled = true
                atualizarListaJogadores()
            else
                if screenGui then
                    screenGui.Enabled = false
                end
            end
        end
    end
end)
