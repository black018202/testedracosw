-- ==========================================
-- 1. CANAL DE COMUNICAÇÃO INTERNO (RemoteEvent)
-- ==========================================
local remoteEvent = ReplicatedStorage:FindFirstChild("AdminChatChannel")
if RunService:IsServer() then
    if not remoteEvent then
        remoteEvent = Instance.new("RemoteEvent")
        remoteEvent.Name = "AdminChatChannel"
        remoteEvent.Parent = ReplicatedStorage
    end

    remoteEvent.OnServerEvent:Connect(function(sender, texto)
        remoteEvent:FireAllClients(sender.Name, texto)
    end)
    return
end

