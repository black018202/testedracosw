-- ==========================================
-- CONFIGURAÇÕES E VARIÁVEIS GLOBAIS (Versão 1.1)
-- ==========================================
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local painelAberto = false
local screenGui = nil
local listaJogadoresFrame = nil
local jogadorSelecionado = nil
local labelSelecionado = nil

-- Criando ou buscando o canal de comunicação (RemoteEvent)
local remoteEvent = ReplicatedStorage:FindFirstChild("AdminPanelEvent")
if not remoteEvent then
    remoteEvent = Instance.new("RemoteEvent")
    remoteEvent.Name = "AdminPanelEvent"
    remoteEvent.Parent = ReplicatedStorage
end

-- ==========================================
-- FUNÇÃO PARA ATUALIZAR A LISTA DE JOGADORES
-- ==========================================
local function atualizarListaJogadores()
    if not listaJogadoresFrame then return end

    -- Limpa os botões antigos para não duplicar
    for _, child in ipairs(listaJogadoresFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local yOffset = 0
    local alturaItem = 35

    -- Varre todos os jogadores do servidor atual
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local btnPlayer = Instance.new("TextButton")
            btnPlayer.Size = UDim2.new(1, 0, 0, alturaItem - 5)
            btnPlayer.Position = UDim2.new(0, 0, 0, yOffset)
            btnPlayer.Text = player.Name
            btnPlayer.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
            btnPlayer.TextColor3 = Color3.fromRGB(255, 255, 255)
            btnPlayer.TextSize = 12
            btnPlayer.Parent = listaJogadoresFrame

            -- Quando clica no jogador da lista, seleciona ele
            btnPlayer.MouseButton1Click:Connect(function()
                jogadorSelecionado = player
                if labelSelecionado then
                    labelSelecionado.Text = "Alvo: " .. player.Name
                    labelSelecionado.TextColor3 = Color3.fromRGB(100, 255, 100)
                end
            end)

            yOffset = yOffset + alturaItem
        end
    end

    -- Ajusta o tamanho da barra de rolagem (ScrollingFrame) dinamicamente
    listaJogadoresFrame.CanvasSize = UDim2.new(0, 0, 0, yOffset)
end

-- ==========================================
-- 1. CRIANDO A INTERFACE (MENU LARGO E COM ROLAGEM)
-- ==========================================
local function criarInterfaceMenu()
