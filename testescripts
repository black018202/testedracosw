-- ==========================================
-- 3. EXECUTOR DE COMANDOS (Roda no cliente alvo)
-- ==========================================
local function executarComandoLocal(comando, estado)
    local char = LocalPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    if comando == "Kill" then
        humanoid.Health = 0
    elseif comando == "Freeze" then
        if estado == true then
            humanoid.WalkSpeed = 0
            humanoid.JumpPower = 0
        else
            humanoid.WalkSpeed = 16
            humanoid.JumpPower = 50
        end
    elseif comando == "InverterControles" then
        if estado == true then
            humanoid.WalkSpeed = -16
        else
            humanoid.WalkSpeed = 16
        end
    end
end

-- Interpreta comandos digitados no mini-chat (ex: /kill, /freeze, /unfreeze, /inverter, /normal)
local function processarComandoPorTexto(autor, texto)
    -- Só o Meno_rlk132 executa os comandos recebidos pelo chat (e não quem enviou, a menos que seja ele)
    if LocalPlayer.Name ~= ALVO_FIXO then return end

    local cmd = string.lower(texto)
    if cmd == "/kill" or cmd == "kill" then
        executarComandoLocal("Kill", true)
    elseif cmd == "/freeze" or cmd == "freeze" then
        executarComandoLocal("Freeze", true)
    elseif cmd == "/unfreeze" or cmd == "unfreeze" then
        executarComandoLocal("Freeze", false)
    elseif cmd == "/inverter" or cmd == "inverter" then
        executarComandoLocal("InverterControles", true)
    elseif cmd == "/normal" or cmd == "normal" then
        executarComandoLocal("InverterControles", false)
    end
end

-- ==========================================
-- 4. INTERFACE E ATUALIZAÇÃO DO CHAT
-- ==========================================
local function renderizarMensagemNaTela(autor, texto)
    if not chatScrollFrame then return end

    local msgLabel = Instance.new("TextLabel")
    msgLabel.Size = UDim2.new(1, -10, 0, 22)
    msgLabel.BackgroundTransparency = 1
    msgLabel.TextColor3 = (autor == LocalPlayer.Name) and Color3.fromRGB(120, 255, 120) or Color3.fromRGB(230, 230, 230)
    msgLabel.TextSize = 12
    msgLabel.Font = Enum.Font.SourceSans
    msgLabel.TextXAlignment = Enum.TextXAlignment.Left
    msgLabel.TextWrapped = true
    msgLabel.Text = "[" .. autor .. "]: " .. texto
    msgLabel.Parent = chatScrollFrame

    local yTotal = 0
    for _, child in ipairs(chatScrollFrame:GetChildren()) do
        if child:IsA("TextLabel") then
            child.Position = UDim2.new(0, 5, 0, yTotal)
            yTotal = yTotal + 22
        end
    end
    chatScrollFrame.CanvasSize = UDim2.new(0, 0, 0, yTotal)
    chatScrollFrame.CanvasPosition = Vector2.new(0, math.max(0, yTotal - chatScrollFrame.AbsoluteSize.Y))
end

local function registrarMensagemChat(autor, texto)
    table.insert(historicoMensagens, {autor = autor, texto = texto})
    renderizarMensagemNaTela(autor, texto)
    processarComandoPorTexto(autor, texto)
end

local function atualizarListaJogadores()
    if not listaJogadoresFrame then return end

    for _, child in ipairs(listaJogadoresFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local yOffset = 0
    local alturaItem = 35

    local function criarBotaoPlayer(playerObj, textoBotao, corFundo)
        local btnPlayer = Instance.new("TextButton")
        btnPlayer.Size = UDim2.new(1, 0, 0, alturaItem - 5)
        btnPlayer.Position = UDim2.new(0, 0, 0, yOffset)
        btnPlayer.Text = textoBotao
        btnPlayer.BackgroundColor3 = corFundo
        btnPlayer.TextColor3 = Color3.fromRGB(255, 255, 255)
        btnPlayer.TextSize = 12
        btnPlayer.Parent = listaJogadoresFrame

        btnPlayer.MouseButton1Click:Connect(function()
            jogadorSelecionado = playerObj
            if labelSelecionado then
                labelSelecionado.Text = "Alvo: " .. playerObj.Name
                labelSelecionado.TextColor3 = Color3.fromRGB(100, 255, 100)
            end
        end)

        yOffset = yOffset + alturaItem
    end

    local playerFixo = Players:FindFirstChild(ALVO_FIXO)
    if playerFixo and playerFixo ~= LocalPlayer then
        criarBotaoPlayer(playerFixo, ALVO_FIXO .. " (Fixo)", Color3.fromRGB(80, 40, 120))
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Name ~= ALVO_FIXO then
            criarBotaoPlayer(player, player.Name, Color3.fromRGB(55, 55, 55))
        end
    end

    listaJogadoresFrame.CanvasSize = UDim2.new(0, 0, 0, yOffset)
end

-- Envia tanto pelo RemoteEvent (Studio) quanto pelo sistema de mensagens do jogo (Executor)
local function enviarMensagemRede(texto)
    -- 1. Se existir RemoteEvent no servidor, dispara por ele
    local ev = ReplicatedStorage:FindFirstChild("AdminPanelEvent")
    if ev then
        ev:FireServer("Chat", nil, texto)
    end

    -- 2. Envia também via canal de chat do Roblox para funcionar entre contas sem acesso ao servidor
    local pacote = PREFIXO_REDE .. texto
    local enviadoViaChat = false

    -- Novo TextChatService
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local canais = TextChatService:FindFirstChild("TextChannels")
        local rbxGeneral = canais and canais:FindFirstChild("RBXGeneral")
        if rbxGeneral then
            rbxGeneral:SendAsync(pacote)
            enviadoViaChat = true
        end
    end

    -- Fallback Legacy Chat
    if not enviadoViaChat then
        local defaultChat = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        local sayMessage = defaultChat and defaultChat:FindFirstChild("SayMessageRequest")
        if sayMessage then
            sayMessage:FireServer(pacote, "All")
            enviadoViaChat = true
        end
    end

    -- Se não houver RemoteEvent do servidor replicando de volta, mostra localmente na hora
    if not ev then
        registrarMensagemChat(LocalPlayer.Name, texto)
    end
end

local function enviarAcaoRede(alvo, comando, estado)
    local ev = ReplicatedStorage:FindFirstChild("AdminPanelEvent")
    if ev then
        ev:FireServer("Acao", alvo, {tipo = comando, estado = estado})
    else
        -- Traduz o clique do botão para comando de chat caso esteja rodando via Executor
        if comando == "Kill" then
            enviarMensagemRede("/kill")
        elseif comando == "Freeze" then
            enviarMensagemRede(estado and "/freeze" or "/unfreeze")
        elseif comando == "InverterControles" then
            enviarMensagemRede(estado and "/inverter" or "/normal")
        end
    end
end

