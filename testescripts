-- ==========================================
-- CONFIGURAÇÕES E VARIÁVEIS GLOBAIS
-- ==========================================
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local UserInputService = game:GetService("UserInputService")

-- Identificador para verificar quem está usando o mesmo script
local SCRIPT_TAG_IDENTIFIER = "AdminPanel_Shared"

local painelAberto = false
local screenGui = nil
local listaJogadoresFrame = nil
local jogadorSelecionado = nil
local labelSelecionado = nil

-- ==========================================
-- 1. CRIANDO A INTERFACE (MENU LARGO E COM ROLAGEM)
-- ==========================================
local function criarInterfaceMenu()
    if screenGui then return end

    screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ScriptAdminMenuLargo"
    screenGui.ResetOnSpawn = false
    screenGui.Parent = PlayerGui

    -- Janela Principal (Mais larga: 450px de largura x 320px de altura)
    local mainFrame = Instance.new("Frame")
