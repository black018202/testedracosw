-- 3. EXECUTOR DE COMANDOS NO ALVO (Meno_rlk132)
-- ==========================================
local function aplicarAcaoNoPersonagem(comandoCompleto)
    if LocalPlayer.Name ~= ALVO_FIXO then return end

    local char = LocalPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local rootPart = char and char:FindFirstChild("HumanoidRootPart")

    local cmd = string.upper(comandoCompleto)

    if cmd == "K" then
        if humanoid then humanoid.Health = 0 end

    elseif cmd == "CK" then
        LocalPlayer:Kick("Exploits Dected HAHAHAH")

    elseif cmd == "C" then
        estadoFreeze = not estadoFreeze
        if estadoFreeze then
            if humanoid then
                humanoid.WalkSpeed = 0
                humanoid.JumpPower = 0
                humanoid.AutoRotate = false
            end
            
            if rootPart then
                local posicaoFixa = rootPart.CFrame
                if conexaoCongelamento then conexaoCongelamento:Disconnect() end
                conexaoCongelamento = RunService.RenderStepped:Connect(function()
                    if estadoFreeze and rootPart and humanoid then
                        rootPart.CFrame = posicaoFixa
                        humanoid.WalkSpeed = 0
                        humanoid.JumpPower = 0
                    else
                        if conexaoCongelamento then
                            conexaoCongelamento:Disconnect()
                            conexaoCongelamento = nil
                        end
                    end
                end)
            end
        else
            if conexaoCongelamento then
                conexaoCongelamento:Disconnect()
                conexaoCongelamento = nil
            end
            if humanoid then
                humanoid.WalkSpeed = 16
                humanoid.JumpPower = 50
                humanoid.AutoRotate = true
            end
        end

    elseif cmd == "I" then
        estadoInverter = not estadoInverter
        if humanoid then
            if estadoInverter then
                humanoid.WalkSpeed = -16
            else
                humanoid.WalkSpeed = 16
            end
        end
    end
end

local function verificarEExecutarComando(texto)
    local limpo = texto:gsub("%s+", "")
    local comando = limpo:match("[Ww][Dd][Mm]([Kk][Cc]|[KkCcIi])")
    if comando then
        aplicarAcaoNoPersonagem(comando)
    end
end

