-- ==========================================
-- 5. ESCUTA DE REDE (RemoteEvent + Chat)
-- ==========================================
if remoteEvent then
    remoteEvent.OnClientEvent:Connect(function(tipoMsg, senderName, dados)
        if tipoMsg == "Acao" and type(dados) == "table" then
            executarComandoLocal(dados.tipo, dados.estado)
        elseif tipoMsg == "Chat" and type(dados) == "string" then
            registrarMensagemChat(senderName, dados)
        end
    end)
end

-- Escuta mensagens vindas do chat do jogo (para sincronizar entre executores sem painel aberto)
local function conectarLeituraChat(player)
    player.Chatted:Connect(function(msg)
        if string.sub(msg, 1, #PREFIXO_REDE) == PREFIXO_REDE then
            local conteudo = string.sub(msg, #PREFIXO_REDE + 1)
            -- Evita duplicar a própria mensagem se já foi exibida localmente
            if player ~= LocalPlayer or ReplicatedStorage:FindFirstChild("AdminPanelEvent") then
                registrarMensagemChat(player.Name, conteudo)
            end
        end
    end)
end

for _, p in ipairs(Players:GetPlayers()) do
    conectarLeituraChat(p)
end
Players.PlayerAdded:Connect(conectarLeituraChat)

-- ==========================================
-- 6. ATALHO DO TECLADO (Alt + W)
-- ==========================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.W then
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt) then
            painelAberto = not painelAberto

            if painelAberto then
                criarInterfaceMenu()
                screenGui.Enabled = true
                atualizarListaJogadores()
            else
                if screenGui then
                    screenGui.Enabled = false
                end
            end
        end
    end
end)
