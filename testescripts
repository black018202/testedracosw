local function atualizarListaJogadores()
    if not listaJogadoresFrame then return end

    -- Limpa lista antiga
    for _, child in ipairs(listaJogadoresFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local yOffset = 0
    local alturaItem = 35

    local function criarBotaoPlayer(nomePlayer, corFundo)
        local btnPlayer = Instance.new("TextButton")
        btnPlayer.Size = UDim2.new(1, 0, 0, alturaItem - 5)
        btnPlayer.Position = UDim2.new(0, 0, 0, yOffset)
        btnPlayer.Text = nomePlayer
        btnPlayer.BackgroundColor3 = corFundo
        btnPlayer.TextColor3 = Color3.fromRGB(255, 255, 255)
        btnPlayer.TextSize = 12
        btnPlayer.Parent = listaJogadoresFrame

        btnPlayer.MouseButton1Click:Connect(function()
            local encontrado = Players:FindFirstChild(nomePlayer)
            if encontrado then
                jogadorSelecionado = encontrado
                if labelSelecionado then
                    labelSelecionado.Text = "Alvo: " .. encontrado.Name
                    labelSelecionado.TextColor3 = Color3.fromRGB(100, 255, 100)
                end
            end
        end)

        yOffset = yOffset + alturaItem
    end

    -- 1. Insere primeiro o nick fixo se ele estiver no servidor
    local playerFixo = Players:FindFirstChild("Meno_rlk132")
    if playerFixo and playerFixo ~= LocalPlayer then
        criarBotaoPlayer("Meno_rlk132 (Fixo)", Color3.fromRGB(80, 40, 120))
    end

    -- 2. Insere os demais jogadores do servidor
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Name ~= "Meno_rlk132" then
            criarBotaoPlayer(player.Name, Color3.fromRGB(55, 55, 55))
        end
    end

    listaJogadoresFrame.CanvasSize = UDim2.new(0, 0, 0, yOffset)
end

local function adicionarMensagemChat(autor, texto)
    if not chatScrollFrame then return end
    
    local msgLabel = Instance.new("TextLabel")
    msgLabel.Size = UDim2.new(1, -10, 0, 20)
    msgLabel.BackgroundTransparency = 1
    msgLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
    msgLabel.TextSize = 11
    msgLabel.TextXAlignment = Enum.TextXAlignment.Left
    msgLabel.Text = "[" .. autor .. "]: " .. texto
    msgLabel.Parent = chatScrollFrame

    -- Organiza o layout do chat verticalmente
    local yTotal = 0
    for _, child in ipairs(chatScrollFrame:GetChildren()) do
        if child:IsA("TextLabel") then
            child.Position = UDim2.new(0, 5, 0, yTotal)
            yTotal = yTotal + 20
        end
    end
    chatScrollFrame.CanvasSize = UDim2.new(0, 0, 0, yTotal)
    chatScrollFrame.CanvasPosition = Vector2.new(0, yTotal)
end

