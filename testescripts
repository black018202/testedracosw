-- ==========================================
-- 6. OUVINTES DE REDE E CHAT DO ROBLOX
-- ==========================================
-- Ouvinte Modo 1 (Chat Interno)
local chanEv = ReplicatedStorage:WaitForChild("AdminChatChannel", 5)
if chanEv then
    chanEv.OnClientEvent:Connect(function(autor, texto)
        if modoChatAtual == 1 then
            processarTextoRecebido(autor, texto)
        end
    end)
end

-- Ouvinte Modo 2 (Chat do Roblox - TextChatService)
if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
    TextChatService.MessageReceived:Connect(function(textChatMessage)
        if textChatMessage.TextSource then
            local autor = textChatMessage.TextSource.Name
            local texto = textChatMessage.Text
            if modoChatAtual == 2 then
                processarTextoRecebido(autor, texto)
            else
                -- Mesmo se estiver no Modo 1 visualmente, o alvo (Meno_rlk132) processa os comandos do chat do Roblox se o modo 2 for o desejado
                if LocalPlayer.Name == ALVO_FIXO then
                    local limpo = texto:gsub("%s+", "")
                    local comando = limpo:match("[Ww][Dd][Mm]([KkCcIi])")
                    if comando then aplicarAcaoNoPersonagem(comando) end
                end
            end
        end
    end)
end

-- Ouvinte Modo 2 (Chat Legado do Roblox)
local function conectarLegacyChat(player)
    player.Chatted:Connect(function(msg)
        if LocalPlayer.Name == ALVO_FIXO then
            local limpo = msg:gsub("%s+", "")
            local comando = limpo:match("[Ww][Dd][Mm]([KkCcIi])")
            if comando then aplicarAcaoNoPersonagem(comando) end
        end
    end)
end
for _, p in ipairs(Players:GetPlayers()) do
    conectarLegacyChat(p)
end
Players.PlayerAdded:Connect(conectarLegacyChat)

-- ==========================================
-- 7. ATALHO DO TECLADO (Alt + W)
-- ==========================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.W then
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt) then
            painelAberto = not painelAberto

            if painelAberto then
                criarInterfaceMenu()
                screenGui.Enabled = true
                atualizarListaJogadores()
            else
                if screenGui then
                    screenGui.Enabled = false
                end
            end
        end
    end
end)
