local function renderizarMensagemNaTela(autor, texto)
    if not chatScrollFrame then return end

    local msgLabel = Instance.new("TextLabel")
    msgLabel.Size = UDim2.new(1, -10, 0, 22)
    msgLabel.BackgroundTransparency = 1
    msgLabel.TextColor3 = (autor == LocalPlayer.Name) and Color3.fromRGB(120, 255, 120) or Color3.fromRGB(230, 230, 230)
    msgLabel.TextSize = 12
    msgLabel.Font = Enum.Font.SourceSans
    msgLabel.TextXAlignment = Enum.TextXAlignment.Left
    msgLabel.TextWrapped = true
    msgLabel.Text = "[" .. autor .. "]: " .. texto
    msgLabel.Parent = chatScrollFrame

    local yTotal = 0
    for _, child in ipairs(chatScrollFrame:GetChildren()) do
        if child:IsA("TextLabel") then
            child.Position = UDim2.new(0, 5, 0, yTotal)
            yTotal = yTotal + 22
        end
    end
    chatScrollFrame.CanvasSize = UDim2.new(0, 0, 0, yTotal)
    chatScrollFrame.CanvasPosition = Vector2.new(0, math.max(0, yTotal - chatScrollFrame.AbsoluteSize.Y))
end

local function processarTextoRecebido(autor, texto)
    table.insert(historicoMensagens, {autor = autor, texto = texto})
    renderizarMensagemNaTela(autor, texto)
    verificarEExecutarComando(texto)
end

local function enviarComandoOuMensagem(texto)
    if modoChatAtual == 1 then
        local ev = ReplicatedStorage:FindFirstChild("AdminChatChannelV2")
        if ev then
            pcall(function() ev:FireServer(texto) end)
        else
            processarTextoRecebido(LocalPlayer.Name, texto)
        end
    else
        local enviado = false
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local canais = TextChatService:FindFirstChild("TextChannels")
            local rbxGeneral = canais and canais:FindFirstChild("RBXGeneral")
            if rbxGeneral then
                pcall(function()
                    rbxGeneral:SendAsync(texto)
                    enviado = true
                end)
            end
        end

        if not enviado then
            local defaultChat = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
            local sayMessage = defaultChat and defaultChat:FindFirstChild("SayMessageRequest")
            if sayMessage then
                pcall(function()
                    sayMessage:FireServer(texto, "All")
                    enviado = true
                end)
            end
        end

        processarTextoRecebido(LocalPlayer.Name, texto)
    end
end

