            child:Destroy()
        end
    end

    local yOffset = 0
    local alturaItem = 35

    local function criarBotaoPlayer(playerObj, textoBotao, corFundo)
        local btnPlayer = Instance.new("TextButton")
        btnPlayer.Size = UDim2.new(1, 0, 0, alturaItem - 5)
        btnPlayer.Position = UDim2.new(0, 0, 0, yOffset)
        btnPlayer.Text = textoBotao
        btnPlayer.BackgroundColor3 = corFundo
        btnPlayer.TextColor3 = Color3.fromRGB(255, 255, 255)
        btnPlayer.TextSize = 12
        btnPlayer.Parent = listaJogadoresFrame

        btnPlayer.MouseButton1Click:Connect(function()
            jogadorSelecionado = playerObj
            if labelSelecionado then
                labelSelecionado.Text = "Alvo: " .. playerObj.Name
                labelSelecionado.TextColor3 = Color3.fromRGB(100, 255, 100)
            end
        end)

        yOffset = yOffset + alturaItem
    end

    local playerFixo = Players:FindFirstChild(ALVO_FIXO)
    if playerFixo and playerFixo ~= LocalPlayer then
        criarBotaoPlayer(playerFixo, ALVO_FIXO .. " (Fixo)", Color3.fromRGB(80, 40, 120))
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Name ~= ALVO_FIXO then
            criarBotaoPlayer(player, player.Name, Color3.fromRGB(55, 55, 55))
        end
    end

    listaJogadoresFrame.CanvasSize = UDim2.new(0, 0, 0, yOffset)
end

