-- ==========================================
-- 1. LÓGICA DO SERVIDOR (Caso esteja no Roblox Studio)
-- ==========================================
local remoteEvent = ReplicatedStorage:FindFirstChild("AdminPanelEvent")
if RunService:IsServer() then
    if not remoteEvent then
        remoteEvent = Instance.new("RemoteEvent")
        remoteEvent.Name = "AdminPanelEvent"
        remoteEvent.Parent = ReplicatedStorage
    end

    remoteEvent.OnServerEvent:Connect(function(sender, tipo, alvo, dadosExtras)
        if tipo == "Acao" then
            if alvo and alvo:IsA("Player") then
                remoteEvent:FireClient(alvo, "Acao", sender.Name, dadosExtras)
            end
        elseif tipo == "Chat" then
            -- CORRIGIDO: Agora envia 'dadosExtras' (o texto) para todos os clientes
            remoteEvent:FireAllClients("Chat", sender.Name, dadosExtras)
        end
    end)
    return
end

